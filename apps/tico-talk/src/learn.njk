---
layout: base.njk
title: Learn — Tico
permalink: /learn/
pageScript: /assets/js/learn.js
---

{% from "menu-categories.njk" import render as renderCategories %}
{% from "venue-header.njk" import venueHeader %}

<div class="learn-screen">

  <div class="learn-picker" id="learn-picker" hidden>
    <p class="page-title">What do you want to learn?</p>

    {% for restaurant in restaurants %}
    <div class="competency-group" data-restaurant="{{ restaurant.id }}">
      <p class="competency-group__label">Food</p>
      <div class="competency-pills">
        {% for category in restaurant.food %}
        <button class="competency-pill" data-restaurant="{{ restaurant.id }}" data-section="{{ category.name }}">{{ category.name }}</button>
        {% endfor %}
      </div>
    </div>

    <div class="competency-group" data-restaurant="{{ restaurant.id }}">
      <p class="competency-group__label">Drinks</p>
      <div class="competency-pills">
        {% for category in restaurant.drinks %}
        <button class="competency-pill" data-restaurant="{{ restaurant.id }}" data-section="{{ category.name }}">{{ category.name }}</button>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>

  <div class="learn-teach" id="learn-teach" hidden>
    {% for restaurant in restaurants %}
      {% for category in restaurant.food %}
      <div class="learn-teach__section" data-restaurant="{{ restaurant.id }}" data-section="{{ category.name }}" hidden>
        {% call venueHeader(restaurant.name, "Food") %}
        <button class="page-header__action learn-start-drill" data-section="{{ category.name }}">
          I'm Ready
          <svg viewBox="2 1 20 17" width="30" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            <path d="M5 14a7 7 0 0 1 14 0"/>
            <line x1="12" y1="6.5" x2="12" y2="4.5"/>
            <circle cx="12" cy="3.6" r="0.9" fill="currentColor" stroke="none"/>
            <path d="M8 11.5a5 5 0 0 1 2.5-3.5" opacity="0.5"/>
            <ellipse cx="12" cy="14.5" rx="8.5" ry="1.7"/>
          </svg>
        </button>
        {% endcall %}
        <p class="learn-teach__intro">Review the content below and click "I'm Ready" once you're ready to practice.</p>
        {{ renderCategories([category], false) }}
      </div>
      {% endfor %}
      {% for category in restaurant.drinks %}
      <div class="learn-teach__section" data-restaurant="{{ restaurant.id }}" data-section="{{ category.name }}" hidden>
        {% call venueHeader(restaurant.name, "Drinks") %}
        <button class="page-header__action learn-start-drill" data-section="{{ category.name }}">
          I'm Ready
          <svg viewBox="2 1 20 17" width="30" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            <path d="M5 14a7 7 0 0 1 14 0"/>
            <line x1="12" y1="6.5" x2="12" y2="4.5"/>
            <circle cx="12" cy="3.6" r="0.9" fill="currentColor" stroke="none"/>
            <path d="M8 11.5a5 5 0 0 1 2.5-3.5" opacity="0.5"/>
            <ellipse cx="12" cy="14.5" rx="8.5" ry="1.7"/>
          </svg>
        </button>
        {% endcall %}
        <p class="learn-teach__intro">Review the content below and click "I'm Ready" once you're ready to practice.</p>
        {{ renderCategories([category], false) }}
      </div>
      {% endfor %}
    {% endfor %}
  </div>

  <div class="learn-drill" id="learn-drill" hidden>
    <p class="menu-review__venue-name" id="learn-drill-restaurant-label"></p>
    <p class="breadcrumb__back learn-back" data-target="picker">‹ Choose a different section</p>
    <div class="learn-transcript-scroll" id="learn-transcript-scroll">
      <div class="transcript learn-transcript" id="learn-transcript"></div>
    </div>
    <div class="learn-input-shell">
      <form class="learn-input-row" id="learn-answer-form" autocomplete="off">
        <div class="learn-input-wrap">
          <textarea
            id="learn-answer-input"
            class="learn-textarea"
            rows="2"
            placeholder="Your reply…"
            aria-label="Your answer"
          ></textarea>
          <div class="learn-input-toolbar">
            <button type="button" class="chat-toolbar-btn" id="learn-flag-btn" hidden aria-label="Flag a correction" data-tooltip="Tico got something wrong or missing? Flag it">
              <svg viewBox="0 0 16 16" fill="currentColor" width="14" height="14" aria-hidden="true">
                <path d="M3 1.5v13M3 2h8.5l-1.5 2.5L11.5 7H3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
              </svg>
            </button>
            <button type="submit" id="learn-send-btn" class="learn-send-btn" disabled aria-label="Send">
              <svg viewBox="0 0 16 16" fill="currentColor" width="14" height="14" aria-hidden="true">
                <path d="M8 1.5L12.5 9H10V14.5H6V9H3.5L8 1.5Z"/>
              </svg>
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

</div>
