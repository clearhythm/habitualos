---
layout: base.njk
title: Menu — Tico
permalink: /menu/
pageScript: /assets/js/menu-restaurant-filter.js
---

{% from "venue-header.njk" import venueHeader %}

{% macro trainIcons(restaurant) %}
<svg class="train-icon" data-content-type="food" viewBox="2 1 20 17" width="30" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
  <path d="M5 14a7 7 0 0 1 14 0"/>
  <line x1="12" y1="6.5" x2="12" y2="4.5"/>
  <circle cx="12" cy="3.6" r="0.9" fill="currentColor" stroke="none"/>
  <path d="M8 11.5a5 5 0 0 1 2.5-3.5" opacity="0.5"/>
  <ellipse cx="12" cy="14.5" rx="8.5" ry="1.7"/>
</svg>
{% if restaurant.id == "margaritaville" %}
<svg class="train-icon" data-content-type="drink" hidden viewBox="2 2 22 19" width="33" height="29" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M3 5c0 5 4 8 9 8s9-3 9-8"/>
  <line x1="12" y1="13" x2="12" y2="20"/>
  <line x1="8" y1="20" x2="16" y2="20"/>
  <path d="M19 3l3.5 2.2-2.2 3.5z" fill="currentColor" stroke="none"/>
</svg>
{% else %}
<svg class="train-icon" data-content-type="drink" hidden viewBox="3 1 18 20" width="27" height="30" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M4 4h16l-8 9z"/>
  <line x1="12" y1="13" x2="12" y2="20"/>
  <line x1="8" y1="20" x2="16" y2="20"/>
  <line x1="9.5" y1="2" x2="13.5" y2="6.5"/>
  <circle cx="11.5" cy="5" r="1.3" fill="currentColor" stroke="none"/>
</svg>
{% endif %}
{% endmacro %}

{% macro skeleton() %}
<div class="menu-skeleton" aria-hidden="true">
  <div class="menu-skeleton__bar menu-skeleton__bar--title"></div>
  <div class="menu-skeleton__bar"></div>
  <div class="menu-skeleton__bar"></div>
  <div class="menu-skeleton__bar"></div>
  <div class="menu-skeleton__bar"></div>
  <div class="menu-skeleton__bar menu-skeleton__bar--title"></div>
  <div class="menu-skeleton__bar"></div>
  <div class="menu-skeleton__bar"></div>
  <div class="menu-skeleton__bar"></div>
  <div class="menu-skeleton__bar"></div>
</div>
{% endmacro %}

{# Category/item content isn't baked here — it's fetched on demand and
   cached client-side (see menu-restaurant-filter.js's loadMenuForRestaurant,
   collections/restaurant-menus.js) so only the current restaurant's menu
   is ever in the DOM, not every restaurant's every time. Panels start
   with a skeleton placeholder; JS replaces it once the fetch (or an
   already-cached, same-day read) resolves. #}
<div id="menu-browse" hidden>
  {% for restaurant in restaurants %}
  <section class="menu-review__venue" data-restaurant="{{ restaurant.id }}" hidden>
    {% call venueHeader(restaurant.name, "Food", true) %}
    <a class="page-header__action" href="#" data-train-link>
      Train
      {{ trainIcons(restaurant) }}
    </a>
    {% endcall %}
    <div class="menu-content-panel" data-content-type="food" hidden>{{ skeleton() }}</div>
    <div class="menu-content-panel" data-content-type="drink" hidden>{{ skeleton() }}</div>
  </section>
  {% endfor %}
</div>

{# One dynamic shell, populated by menu-restaurant-filter.js's
   renderDetailBlock — category names aren't known at build time anymore,
   so this can no longer be one baked-and-hidden block per category
   (same reasoning as #menu-practice's transcript being a single shared
   shell rather than duplicated per category). #}
<div id="menu-detail" hidden></div>

<div class="learn-drill" id="menu-practice" hidden>
  <div class="transcript learn-transcript" id="learn-transcript"></div>
  <div class="learn-input-shell">
    <form class="learn-input-row" id="learn-answer-form" autocomplete="off">
      <div class="learn-input-wrap">
        <textarea
          id="learn-answer-input"
          class="learn-textarea"
          rows="2"
          placeholder="Your reply…"
          aria-label="Your answer"
        ></textarea>
        <div class="learn-input-toolbar">
          <button type="button" class="chat-toolbar-btn" id="learn-flag-btn" hidden aria-label="Flag a correction" data-tooltip="Tico got something wrong or missing? Flag it">
            <svg viewBox="0 0 16 16" fill="currentColor" width="14" height="14" aria-hidden="true">
              <path d="M3 1.5v13M3 2h8.5l-1.5 2.5L11.5 7H3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
            </svg>
          </button>
          <button type="submit" id="learn-send-btn" class="learn-send-btn" disabled aria-label="Send">
            <svg viewBox="0 0 16 16" fill="currentColor" width="14" height="14" aria-hidden="true">
              <path d="M8 1.5L12.5 9H10V14.5H6V9H3.5L8 1.5Z"/>
            </svg>
          </button>
        </div>
      </div>
    </form>
  </div>
</div>
