<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "Tico" }}</title>
  <link rel="icon" type="image/png" href="/assets/images/tico-logomark.png">
  <link rel="stylesheet" href="/styles/main.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %} data-first-restaurant-id="{{ restaurants[0].id }}">
  {# contentType ('marketing' | 'app', defaults to 'app' when absent) is
     the primary flag — it alone picks the nav below, and the footer
     mirrors it too unless a page sets footerType to override just the
     footer. Two flags because one page needs to mix and match: /app/
     wants the app nav but keeps its marketing tagline footer (footerType:
     marketing there, contentType left at the 'app' default). #}
  {% if not noNav %}
    {% from "nav.njk" import marketingNav, appNav %}
    {% if contentType == 'marketing' %}{{ marketingNav() }}{% else %}{{ appNav() }}{% endif %}
  {% endif %}

  <main class="main">
    {% if noContainer %}
      {{ content | safe }}
    {% else %}
      <div class="container{% if contentType == 'marketing' %} container--marketing{% endif %}">
        {{ content | safe }}
      </div>
    {% endif %}
  </main>

  {# Future auth hook: once real sign-in exists, this is where a
     contentType != 'marketing' page should redirect to login if there's
     no session. Keying off contentType (already page-level metadata,
     not a URL prefix) means today's choice to skip a literal /app/
     URL-prefix architecture doesn't box that in later — /app/ itself
     stays contentType: 'app' (the default) on purpose, since it's meant
     to work as a pre-auth orientation screen, not a gated page. #}
  {% if not noFooter %}
    {% set effectiveFooterType = footerType or contentType %}
    {% from "footer.njk" import marketingFooter, appFooter %}
    {% if effectiveFooterType == 'marketing' %}{{ marketingFooter() }}{% else %}{{ appFooter() }}{% endif %}
  {% endif %}

  <script type="module" src="/assets/js/navigation.js"></script>
  {% if pageScript %}<script type="module" src="{{ pageScript }}"></script>{% endif %}
</body>
</html>
