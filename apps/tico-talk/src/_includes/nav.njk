<div class="nav-bar" id="nav-bar">
  <div class="nav-bar__slot nav-bar__slot--left">
    <button id="sidemenu-toggle" class="nav-hamburger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="nav-bar__brand">
    {% if not hideNavLabel %}<a href="/"><img class="nav-bar__logo" src="/assets/images/tico-logo.webp" alt="Tico" width="614" height="313"></a>{% endif %}
  </div>

  <div class="nav-bar__slot nav-bar__slot--right">
    {% if showHelp %}<button class="nav-bar__help" id="how-it-works-trigger" aria-label="How it works">?</button>{% endif %}
  </div>
</div>

<div class="sidemenu-main" id="sidemenu-main">
  <div class="sidemenu-left">
    {% if restaurants.length %}
    <div class="sidemenu-venue-switcher">
      <button class="sidemenu-venue" id="restaurant-switcher-trigger" aria-expanded="false" aria-label="Switch restaurant">
        <span id="current-restaurant-name">{{ restaurants[0].name }}</span>
        <span class="sidemenu-venue__chevron" aria-hidden="true">▾</span>
      </button>
      <div class="restaurant-switcher" id="restaurant-switcher" hidden>
        {% for restaurant in restaurants %}
        <button class="restaurant-switcher__option" data-restaurant-id="{{ restaurant.id }}">{{ restaurant.name }}</button>
        {% endfor %}
      </div>
    </div>
    {% endif %}
    <ul>
      <li><a href="/menu/">Menu</a></li>
      <li><a href="#" class="sidemenu-disabled" aria-disabled="true">Off-Menu</a></li>
      <li><a href="#" class="sidemenu-disabled" aria-disabled="true">Recommendations</a></li>
      <li><a href="#" class="sidemenu-disabled" aria-disabled="true">Upselling</a></li>
      <li><a href="#" class="sidemenu-disabled" aria-disabled="true">Complaints</a></li>
      <li><a href="#" class="sidemenu-disabled" aria-disabled="true">Languages</a></li>
      <li><a href="/stats/">Progress</a></li>
    </ul>
    <div class="sidemenu-footer">
      <div class="sidemenu-auth">
        <a href="/profile/" class="sidemenu-auth-profile">
          <span class="sidemenu-auth-avatar" aria-hidden="true">🧑</span>
          <span class="sidemenu-auth-name">Erik</span>
        </a>
        <a href="#" class="sidemenu-auth-link">Sign out</a>
      </div>
      <div class="sidemenu-footer-row">
        <span class="sidemenu-logo" aria-hidden="true">🌮</span>
        <p class="sidemenu-copyright">Tico — Talk with Confidence</p>
      </div>
      <a href="/about/" class="sidemenu-about-link">About</a>
    </div>
  </div>
  <div class="sidemenu-right">
    <div class="sidemenu-overlay" id="sidemenu-overlay"></div>
  </div>
</div>
